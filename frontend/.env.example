# Plantilla de referencia — las variables reales van en `.env.development` (modo dev,
# `npm run dev`, backend local de Fase 12) y `.env.production` (modo prod,
# `npm run dev:cloud` / `npm run build`, backend AWS real). Vite carga el archivo del
# modo automáticamente; este `.env` base queda vacío a propósito. Ambos `.env.*` reales
# están gitignored — copiá este archivo con el nombre que corresponda y completá:

# URL base de API Gateway (local: http://127.0.0.1:3000, AWS real: `terraform output api_gateway_url`)
VITE_API_URL=

# Datos de Cognito (`terraform output` en infra/: cognito_user_pool_id, cognito_client_id,
# cognito_domain). Si se dejan vacías, el frontend arranca sin login — así debe quedar
# `.env.development`, porque el backend local todavía no valida JWT (Fase 12).
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=
